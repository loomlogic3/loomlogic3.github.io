{
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "package*.json"
    ],
    "rewrites": [
      {
        "source": "/api/inquiries",
        "function": {
          "functionId": "submitInquiry",
          "region": "us-central1"
        }
      }
    ]
  }
}
