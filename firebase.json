{
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "package*.json"
    ],
    "rewrites": [
      {
        "source": "/api/inquiries",
        "function": {
          "functionId": "submitInquiry",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/admin/verify",
        "function": {
          "functionId": "verifyAdmin",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/social-drafts",
        "function": {
          "functionId": "manageSocialDrafts",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/ai/chat",
        "function": {
          "functionId": "aiChat",
          "region": "us-central1"
        }
      }
    ]
  }
}
